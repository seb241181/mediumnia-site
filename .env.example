# MediumIA Agents — variables publiques Vite
# Ces deux valeurs sont destinées au client. Ne jamais mettre de service_role key dans Vite ou GitHub.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# MediumIA Agents — secrets serveur uniquement
# À configurer dans Vercel sans préfixe VITE_. Ne jamais les exposer au navigateur ni les committer.
ANTHROPIC_API_KEY=
# Optionnel : permet de choisir explicitement le modèle Claude côté serveur.
ANTHROPIC_AGENT_MODEL=

# Fournisseur alternatif optionnel pour de futurs agents provider=openai.
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=

# ── MediumIA Rendez-vous — Google OAuth ─────────────────────────────────────
# Créer les credentials dans Google Cloud Console → APIs & Services → Credentials
# Type : "ID client OAuth 2.0" → Application Web
# Ajouter dans "URI de redirection autorisés" : https://<votre-domaine>/api/google-calendar/callback
# ATTENTION : l'URI de redirection doit correspondre EXACTEMENT (scheme, host, path inclus).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://<votre-preview-url>/api/google-calendar/callback

# Clé de chiffrement AES-256 pour les tokens OAuth Google (32 octets = 64 caractères hex).
# Générer avec : openssl rand -hex 32
# Ne jamais réutiliser entre environnements. Perte = obligation de reconnecter tous les praticiens.
CALENDAR_TOKEN_ENCRYPTION_KEY=

# ── MediumIA Rendez-vous — Supabase (service role) ──────────────────────────
# Différent des clés VITE_ (usage serveur uniquement, jamais exposé au navigateur).
# Dashboard Supabase → Project Settings → API → service_role key
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Oracle — anti-abus IP (serveur uniquement) ────────────────────────────
# Secret HMAC pour pseudonymiser les IP. Générer avec : openssl rand -hex 32
# Sans cette variable, le rate limiting IP est désactivé (le tirage unique par e-mail reste actif).
ORACLE_RATE_LIMIT_SECRET=
